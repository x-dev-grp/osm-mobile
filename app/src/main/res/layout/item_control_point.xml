<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@color/abiooc_card_bg"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Dot indicator -->
        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_abiooc_circle_outline_green"
            android:backgroundTint="@color/abiooc_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvControlPointName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/abiooc_text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvControlPointType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/abiooc_text_gray"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <EditText
        android:id="@+id/etControlPointValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_abiooc_card"
        android:hint="Valeur mesurée"
        android:inputType="text"
        android:padding="12dp"
        android:textColor="@color/abiooc_text_dark"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etControlPointComment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_abiooc_card"
        android:hint="Commentaire (optionnel)"
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:textColor="@color/abiooc_text_dark"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnControlPointPhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/abiooc_bg"
            android:drawableStart="@android:drawable/ic_menu_camera"
            android:drawableTint="@color/abiooc_text_gray"
            android:text="Prendre photo"
            android:textColor="@color/abiooc_text_gray"
            android:textSize="12sp"
            app:cornerRadius="8dp" />

        <ImageView
            android:id="@+id/ivControlPointPhoto"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:contentDescription="Photo du point"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/abiooc_stroke" />

</LinearLayout>