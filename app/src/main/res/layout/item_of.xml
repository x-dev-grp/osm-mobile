<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/abiooc_stroke"
    app:strokeWidth="1dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">
            <TextView
                android:id="@+id/tvOfNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OF - 2025-0001"
                android:textColor="@color/gray"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOfStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_tag_green"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="En cours"
                android:textColor="@color/status_in_progress_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_production_order"
                app:tint="@color/abiooc_text_dark" />

            <TextView
                android:id="@+id/tvOfSku"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Bouteille huile EV 500 ml"
                android:textColor="@color/abiooc_text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Début / fin prévus"
                android:textColor="@color/abiooc_text_gray"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvOfDates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="01/07/2025 → 03/07/2025"
                android:textColor="@color/abiooc_text_dark"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Cible"
                android:textColor="@color/abiooc_text_gray"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvOfTarget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:text="2000 u."
                android:textColor="@color/abiooc_text_dark"
                android:textSize="12sp"
                android:textStyle="bold" />
                
            <TextView
                android:id="@+id/tvLabelNC"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Non conformes"
                android:textColor="#C62828"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvOfNC"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:text="38 u."
                android:textColor="#C62828"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </GridLayout>

        <!-- PROGRESS BAR -->
        <LinearLayout
            android:id="@+id/layoutOfProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp">

            <ProgressBar
                android:id="@+id/pbOfProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:progress="66"
                android:progressDrawable="@drawable/bg_abiooc_progress" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvOfBonnes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1320 bonnes"
                    android:textColor="@color/abiooc_text_gray"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvOfPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="66%"
                    android:textColor="@color/abiooc_text_gray"
                    android:textSize="11sp" />
            </RelativeLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/abiooc_stroke" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_code"
                app:tint="@color/abiooc_text_gray" />

            <TextView
                android:id="@+id/tvOfLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Ligne A"
                android:textColor="@color/abiooc_text_gray"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_scan_qr"
                app:tint="@color/abiooc_text_gray" />

            <TextView
                android:id="@+id/tvOfLot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="LOT-2025-07-01"
                android:textColor="@color/abiooc_text_gray"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/abiooc_text_gray" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
